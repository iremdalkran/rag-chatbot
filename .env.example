# Bu dosyayı ".env" adıyla kopyalayıp değerleri değiştirebilirsiniz. Hepsi isteğe bağlıdır;
# boş bırakılan ayarlar için varsayılan değer kullanılır.

# --- Yapay zekâ modelleri (Ollama) ---
OLLAMA_URL=http://localhost:11434
# Sohbet modeli. 24 GB Apple Silicon için önerilen: qwen3:14b
#   Daha hızlı / daha az bellek: qwen3:8b
#   Daha akıllı ama belleği zorlar: qwen3:30b-a3b
CHAT_MODEL=qwen3:14b
# Doküman arama (embedding) modeli. Türkçe dahil çok dilli: bge-m3
# DİKKAT: Bunu değiştirirseniz mevcut dokümanları silip yeniden yüklemeniz gerekir.
EMBED_MODEL=bge-m3
# Modelin bir seferde işleyebildiği metin miktarı (token)
LLM_CONTEXT_TOKENS=8192

# --- Sunucu ---
# Sadece bu bilgisayardan erişim: 127.0.0.1 — Şirket ağından erişim: 0.0.0.0
HOST=127.0.0.1
PORT=8000
# Verilerin (veritabanı, tablolar) tutulduğu klasör
# DATA_DIR=./data

# --- Güvenlik ---
# Kullanıcılar kendi kendine kayıt olabilsin mi? (Kapalıyken kullanıcıları yönetici ekler.)
ALLOW_REGISTRATION=false
MIN_PASSWORD_LENGTH=8
SESSION_DAYS=7
# HTTPS (https://...) arkasında yayınlıyorsanız true yapın
COOKIE_SECURE=false

# --- Doküman işleme ---
MAX_UPLOAD_MB=50
RETRIEVAL_TOP_K=6

# --- Doküman arama yöntemi ---
# vector    : parçalara bölüp anlam + kelime araması (varsayılan, hızlı)
# pageindex : her doküman için içindekiler ağacı kurulur; model soruya göre ilgili bölümleri seçip
#             o sayfaları okur (vektör kullanmaz). Ağaç yükleme sırasında bir kez kurulur.
# Değiştirdikten sonra uygulamayı yeniden başlatın; gereken ağaçlar arka planda kendiliğinden kurulur.
RAG_METHOD=vector
# PageIndex: soru başına okunacak en fazla bölüm ve modele verilecek en fazla metin (karakter)
# PAGEINDEX_MAX_NODES=4
# PAGEINDEX_MAX_CONTEXT_CHARS=12000
# Ağaçlar her yüklemede kurulsun mu? auto: sadece RAG_METHOD=pageindex iken, always: her zaman
# (iki yöntem arasında beklemeden geçiş yapmak isterseniz always seçin)
# PAGEINDEX_BUILD=auto
